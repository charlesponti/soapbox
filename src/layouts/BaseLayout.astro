---
/* BaseLayout — thin wrapper over Shell (style="essay"). Owns the Tailwind
   entry (global.css) and the ClientRouter; everything else is the Shell. */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Shell from "./Shell.astro";

interface Props {
  title?: string;
  description?: string;
  url?: string;
  jsonldType?: string;
  ogImage?: string;
  section?: "essays" | "decks" | null;
  footing?: string;
}

const { section = null, ...head } = Astro.props;
---

<Shell style="essay" section={section} {...head}>
  <ClientRouter slot="client-router" />
  <slot />
  <slot name="script" slot="script" />
</Shell>
