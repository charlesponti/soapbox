---
/* Site.astro — thin wrapper over Shell (style="deck") for the decks index
   and its gallery views. Shell CSS lives in components/deck.css (cached);
   this file carries no styles. `view` keeps the cover/wall/ledger/orb
   switcher state for the one gallery route. */
import Shell from "./Shell.astro";
import manifest from "../../decks.json";

interface Props {
  title?: string;
  description?: string;
  view?: string;
  footing?: string;
}

const {
  title = "Soapbox — Decks",
  description = "Full-screen decks, talked over.",
  view = "cover",
  footing = "GEIST · NO CDN · EVERY SCENE FITS 1600×900",
} = Astro.props;
const section = view === "orb" ? null : ("decks" as const);
const orb = view === "orb";
---

<Shell
  style="deck"
  section={section}
  title={title}
  description={description}
  footing={view === "orb" ? "WAVEFORM · INTERACTIVE ENGINEERING" : footing}
  bodyClass={orb ? "site-orb" : ""}
>
  <span slot="head" data-deck-count={manifest.decks.length}></span>
  {orb ? <slot /> : <main class="site-main"><slot /></main>}
  <slot name="script" slot="script" />
</Shell>
