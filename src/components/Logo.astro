---
/* Brand mark — stays on screen across navigations via the client router's
   persist optimization (same DOM node survives the swap). */
import SoapboxMark from "./SoapboxMark.astro";
---
<a
  href="/"
  transition:persist
  class="logo-nav fixed right-5 top-5 z-30 flex items-center gap-2 text-foreground transition-transform duration-150 hover:rotate-3"
  aria-label="Soapbox home"
  title="Back to Soapbox"
>
  <SoapboxMark size={26} />
  <span class="font-mono text-[12px] tracking-[0.14em]">SOAPBOX</span>
</a>
