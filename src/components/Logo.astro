---
// Brand mark — stays on screen across navigations via the client router's
// persist optimization (same DOM node survives the swap).
---
<a
  href="/"
  transition:persist
  class="logo-nav fixed right-5 top-5 z-30 block text-foreground transition-transform duration-150 hover:rotate-12"
  aria-label="Essays home"
  title="Back to essays"
>
  <svg
    width="26"
    height="26"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 21c7.5 0 13.5-3.5 16-11" />
    <path d="M7.5 18.5c1.8-1.7 2.6-4.5 2.1-7.5" />
    <path d="M12.5 13.5c1.3-1 1.4-3 .4-4.6" />
    <path d="M9.5 8c2 1.8 5 2 7.5.8" />
  </svg>
</a>