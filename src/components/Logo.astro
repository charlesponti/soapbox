---
// Brand mark — an isometric soapbox cube. Stays on screen across
// navigations via the client router's persist optimization (same DOM node
// survives the swap).
---
<a
  href="/"
  transition:persist
  class="logo-nav fixed right-5 top-5 z-30 block text-foreground transition-transform duration-150 hover:rotate-12"
  aria-label="Essays home"
  title="Back to essays"
>
  <svg
    width="26"
    height="26"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" />
    <path d="M12 12l8-4.5M12 12L4 7.5M12 12v9" />
  </svg>
</a>