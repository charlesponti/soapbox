---

<BaseLayout title="Animated: Source Ingestion" description="Interactive animated diagram for the Seme memory system" jsonldType="Article">
  <main class="mx-auto max-w-4xl px-6 pb-24 pt-20" data-pagefind-body>
    <a href="/essays/" class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background/85 px-3.5 py-1.5 text-sm text-muted-foreground backdrop-blur hover:border-foreground/40 hover:text-foreground mb-8">
      ← Back
    </a>
    <style is:inline set:html={cssContent} />
    <div set:html={htmlContent} />
    <script is:inline set:html={jsContent} />
  </main>
</BaseLayout>
