---
import Deck from '../../layouts/Deck.astro';
---
<Deck title="Source Ingestion" brand="SOURCE INGESTION" series="SEME · DIAGRAM 05" replayHint={true}
  category="technology"
  description="URLs, PDFs, transcripts, pasted text — four doors into the same five-step pipeline.">
<deck-cue time="COVER" title="The title">Open on the title. Four doors, one pipeline. Meet the doors first.</deck-cue>
<deck-cue time="STEP 1 · DOORS" title="Four doors">URL, PDF, YouTube, pasted text. One /ingest/source call branches on the payload.</deck-cue>
<deck-cue time="STEP 2 · PIPELINE" title="Five steps">Fetch, extract, chunk, turn, extract. Watch a URL walk all five.</deck-cue>
<deck-cue time="STEP 3 · PROVENANCE" title="The pointer">Every memory carries a source pointer back to its document and paragraph.</deck-cue>
<deck-cue time="CLOSE" title="Same pipe">Four doors, one pipe, zero special cases. Hand off to the deep-dive essay.</deck-cue>

<deck-scene id="s0" title="SEME · DIAGRAM 05" layout="full" cover>
<h1 class="rise">Source Ingestion</h1>
<p class="lede rise">Four doors. One pipeline.</p>
</deck-scene>

<deck-scene id="s1" title="DOORS" layout="split"><div>
<h2 class="rise">Four doors,<br><em class="serif">one call.</em></h2>
<p class="lede rise">A single endpoint branches on the payload. YouTube sniffs by hostname.</p>
<button class="replay rise" data-replay="sources"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE DOORS</button></div>
<div class="diagram rise"><div class="dlabel"><span>ENTRY POINTS</span><span>/INGEST/SOURCE</span></div>
<div class="res" id="res-doors"></div>
<p class="note">Same shape in, whatever the door.</p></div></deck-scene>

<deck-scene id="s2" title="PIPELINE" layout="split"><div>
<h2 class="rise">Five steps,<br><em class="serif">every time.</em></h2>
<p class="lede rise">A URL walks the pipe. The other three doors walk the same five.</p>
<button class="replay rise" data-replay="pipeline"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE PIPE</button></div>
<div class="diagram rise"><div class="dlabel"><span>PIPELINE · URL</span><span id="pipe-step">READY</span></div>
<div class="pflow" id="pipe-flow"></div>
<p class="note" id="pipe-note">Paragraph chunks stay whole — no sliced sentences.</p></div></deck-scene>

<deck-scene id="s3" title="PROVENANCE" layout="split"><div>
<h2 class="rise">Every memory<br><em class="serif">points home.</em></h2>
<p class="lede rise">Each turn keeps its source row: document, paragraph, type.</p>
<button class="replay rise" data-replay="provenance"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE CHAIN</button></div>
<div class="diagram rise"><div class="dlabel"><span>PROVENANCE</span><span>TRACEABLE</span></div>
<deck-flow class="rise" id="prov-flow">
<deck-step>MEMORY</deck-step><deck-step>PARAGRAPH</deck-step><deck-step>DOCUMENT</deck-step>
</deck-flow>
<p class="note" id="prov-note">Ask where a fact came from — walk the chain.</p></div></deck-scene>

<deck-scene id="s4" title="CLOSE" layout="full">
<div class="finish serif rise">Four doors, one pipe, zero special cases.</div>
<p class="lede rise" style="margin-top:26px">Extraction runs exactly as it does for conversation. The deep dive sits under Essays, Source Ingestion.</p>
</deck-scene>
</Deck>

<style is:inline slot="head">
.res{margin-top:6px;min-height:60px}
.chip{display:inline-block;border:1px solid #333;border-radius:8px;padding:10px 14px;margin:0 8px 8px 0;font-size:13px;background:var(--panel)}
.pflow{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:6px}
.pnode{border:1px solid var(--line);border-radius:8px;background:var(--panel);padding:10px 8px;font-size:11px;min-height:118px;opacity:.35}
.pnode.on{opacity:1;border-color:#fff}
.pnode h4{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--g1);margin:0 0 8px}
.pnode.on h4{color:var(--ink)}
.pnode .bd{font-family:var(--mono);font-size:10.5px;line-height:1.55;color:var(--g1);white-space:pre-line}
.pnode.on .bd{color:var(--ink)}
@media(max-width:760px){.pflow{grid-template-columns:repeat(2,1fr)}}
</style>

<!--
ACCENT AUDIT (SYSTEM.md §2): no coloured components — monochrome throughout,
emphasis by border and opacity only. The nav mark is the shared brand component
owned by components/deck-stage.js.
-->

<script is:inline slot="script">
/* One script, one declaration of everything. The stage fires each scene's
   builder on first view and on R. */
(function () {
  const beat = () => window.DECK_BEAT || 900;
  const reduced = () => !!window.deckBuild.reduced;
  const motion = () => window.deckBuild.Motion;
  const DOORS = ['URL', 'PDF', 'YOUTUBE', 'PASTED TEXT'];
  const STEPS = [
    { h: 'FETCH', lines: ['GET post', '200 · html'] },
    { h: 'EXTRACT', lines: ['strip tags', '1,842 words'] },
    { h: 'CHUNK', lines: ['6 paragraphs', 'max 900 chars'] },
    { h: 'TURNS', lines: ['6 turns', 'role: user'] },
    { h: 'EXTRACT', lines: ['2 entities', '1 relation', '3 memories'] },
  ];

  function enter(el, delayMs) {
    const M = motion();
    if (reduced() || !M) return;
    M.animate(el, { opacity: [0, 1], y: [8, 0] }, { duration: 0.4, delay: delayMs / 1000, ease: [0.22, 1, 0.36, 1] });
  }

  function playSources() {
    const box = document.getElementById('res-doors');
    box.innerHTML = '';
    DOORS.forEach((d, i) => {
      const show = () => {
        const chip = document.createElement('span');
        chip.className = 'chip';
        chip.textContent = d;
        box.appendChild(chip);
        enter(chip, 0);
      };
      if (reduced()) show();
      else setTimeout(show, i * beat());
    });
  }

  function playPipeline() {
    const flow = document.getElementById('pipe-flow');
    const stepEl = document.getElementById('pipe-step');
    flow.innerHTML = '';
    const nodes = STEPS.map((s) => {
      const n = document.createElement('div');
      n.className = 'pnode';
      const h = document.createElement('h4');
      h.textContent = s.h;
      const bd = document.createElement('div');
      bd.className = 'bd';
      bd.textContent = '—';
      n.appendChild(h);
      n.appendChild(bd);
      flow.appendChild(n);
      return { n, bd, lines: s.lines };
    });
    stepEl.textContent = 'FETCH';
    nodes.forEach((node, i) => {
      const run = () => {
        node.n.classList.add('on');
        stepEl.textContent = STEPS[i].h;
        node.lines.forEach((line, k) => {
          const add = () => {
            node.bd.textContent = node.bd.textContent === '—' ? line : node.bd.textContent + '\n' + line;
          };
          if (reduced()) add();
          else setTimeout(add, k * (beat() / 3));
        });
      };
      if (reduced()) run();
      else setTimeout(run, i * beat());
    });
  }

  function playProvenance() {
    const flow = document.getElementById('prov-flow');
    const steps = [...flow.querySelectorAll('deck-step')];
    steps.forEach((s) => s.classList.remove('on'));
    if (reduced()) {
      steps.forEach((s) => s.classList.add('on'));
      return;
    }
    steps.forEach((s, i) => setTimeout(() => s.classList.add('on'), i * beat()));
  }

  window.deckBuild.register({
    sources: playSources,
    pipeline: playPipeline,
    provenance: playProvenance,
  });
})();
</script>
