---
import Deck from '../../layouts/Deck.astro';
---
<Deck title="Knowledge Graph" brand="KNOWLEDGE GRAPH" series="SEME · DIAGRAM 02" replayHint={true}
  category="technology"
  description="Six entities, six edges, in SQLite. Two hops out, one shortest path — no graph database.">
<deck-cue time="COVER" title="The title">Open on the title. Six nodes, six edges, zero graph databases. Build it first.</deck-cue>
<deck-cue time="STEP 1 · BUILD" title="Entities in">Nodes drop in one per beat, then the edges wire up. Six and six.</deck-cue>
<deck-cue time="STEP 2 · 2 HOPS" title="Traversal">Two hops out from Charles: the direct neighbours, then their neighbours. This is retrieval finding context.</deck-cue>
<deck-cue time="STEP 3 · PATH" title="Shortest path">Breadth-first, Charles to Edinburgh, two hops through Ponti Studios. Depth first would wander; BFS doesn't.</deck-cue>
<deck-cue time="CLOSE" title="Pure SQL">Recursive CTEs. The query you already have, pointed at the graph.</deck-cue>

<deck-scene id="s0" title="SEME · DIAGRAM 02" layout="full" cover>
<h1 class="rise">Knowledge Graph</h1>
<p class="lede rise">Six nodes. No graph database.</p>
</deck-scene>

<deck-scene id="s1" title="BUILD" layout="split"><div>
<h2 class="rise">Entities in.<br><em class="serif">Edges between.</em></h2>
<p class="lede rise">Typed nodes, labelled edges, source provenance on every one.</p>
<button class="replay rise" data-replay="build"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE BUILD</button></div>
<div class="diagram rise"><div class="dlabel"><span>GRAPH · 6 + 6</span><span id="build-state">EMPTY</span></div>
<svg class="canvas" id="cv-build" viewBox="0 0 820 400" role="img" aria-label="Knowledge graph"></svg>
<p class="note">People, orgs, places, tools — one shared canvas.</p></div></deck-scene>

<deck-scene id="s2" title="2 HOPS" layout="split"><div>
<h2 class="rise">Two hops out<br><em class="serif">from Charles.</em></h2>
<p class="lede rise">Neighbours, then neighbours-of-neighbours. Retrieval finding context.</p>
<button class="replay rise" data-replay="traverse"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE TRAVERSAL</button></div>
<div class="diagram rise"><div class="dlabel"><span>N-HOP · FROM CHARLES</span><span id="trav-state">READY</span></div>
<svg class="canvas" id="cv-trav" viewBox="0 0 820 400" role="img" aria-label="Two-hop traversal"></svg>
<p class="note">Hop zero is Charles. Everything else is found, not fetched.</p></div></deck-scene>

<deck-scene id="s3" title="PATH" layout="split"><div>
<h2 class="rise">Two hops.<br><em class="serif">One answer.</em></h2>
<p class="lede rise">Breadth-first from Charles to Edinburgh, through Ponti Studios.</p>
<button class="replay rise" data-replay="path"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE SEARCH</button></div>
<div class="diagram rise"><div class="dlabel"><span>SHORTEST PATH · BFS</span><span id="path-state">READY</span></div>
<svg class="canvas" id="cv-path" viewBox="0 0 820 400" role="img" aria-label="Shortest path"></svg>
<p class="note">Charles, works at, Ponti Studios, located in, Edinburgh.</p></div></deck-scene>

<deck-scene id="s4" title="CLOSE" layout="full">
<div class="finish serif rise">Recursive CTEs. Pure SQL.</div>
<p class="lede rise" style="margin-top:26px">No graph database. Just the query you already have. The deep dive sits under Essays, Knowledge Graph.</p>
</deck-scene>
</Deck>

<style is:inline slot="head">
.canvas{width:100%;height:auto;display:block;background:#050505;border:1px solid var(--line);border-radius:8px}
.canvas text{font-family:var(--mono)}
.gnode{opacity:0}
.gnode circle{fill:#0d0d0d;stroke:#666;stroke-width:2}
.gnode .nm{fill:#fff;font-size:15px;font-weight:700;text-anchor:middle}
.gnode .tp{fill:#666;font-size:10px;letter-spacing:.12em;text-anchor:middle}
.gedge{opacity:0}
.gedge line{stroke:#333;stroke-width:2}
.gedge text{fill:#666;font-size:11px;text-anchor:middle}
.gnode.lit circle{stroke:#E4181B;stroke-width:3}
.gnode.lit .nm{fill:#E4181B}
.gedge.lit line{stroke:#E4181B;stroke-width:3}
.gedge.lit text{fill:#E4181B}
.gnode.dim,.gedge.dim{opacity:.18}
</style>

<!--
ACCENT AUDIT (SYSTEM.md §2): the visited/path red (#E4181B) is the one
semantic state of this deck — on the traversal, lit, off it, dimmed.
Everything else is monochrome. The nav mark is the shared brand component
owned by components/deck-stage.js.
-->

<script is:inline slot="script">
/* One script, one declaration of everything. The stage fires each scene's
   builder on first view and on R. Each graph scene owns its SVG so replay
   and direct entry always start clean. */
(function () {
  const NS = 'http://www.w3.org/2000/svg';
  const beat = () => window.DECK_BEAT || 900;
  const reduced = () => !!window.deckBuild.reduced;
  const motion = () => window.deckBuild.Motion;

  const NODES = [
    { id: 'charles', x: 110, y: 190, label: 'Charles', type: 'PERSON' },
    { id: 'ponti', x: 320, y: 100, label: 'Ponti Studios', type: 'ORG' },
    { id: 'edinburgh', x: 540, y: 190, label: 'Edinburgh', type: 'PLACE' },
    { id: 'typescript', x: 310, y: 300, label: 'TypeScript', type: 'TOOL' },
    { id: 'cyndi', x: 110, y: 330, label: 'Cyndi', type: 'ANIMAL' },
    { id: 'sarah', x: 550, y: 330, label: 'Sarah', type: 'PERSON' },
  ];
  const EDGES = [
    { from: 'charles', to: 'ponti', label: 'works_at' },
    { from: 'ponti', to: 'edinburgh', label: 'located_in' },
    { from: 'charles', to: 'typescript', label: 'uses' },
    { from: 'charles', to: 'cyndi', label: 'owns' },
    { from: 'charles', to: 'sarah', label: 'partner' },
    { from: 'ponti', to: 'typescript', label: 'uses' },
  ];
  const byId = (id) => NODES.find((n) => n.id === id);

  function el(name, attrs) {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  }

  function enter(node, delayMs) {
    if (reduced()) {
      node.style.opacity = '1';
      return;
    }
    // Native WAAPI, not Motion: Motion 11's animate() silently no-ops on SVG
    // <g> content in Chromium (verified: no error, no effect), while WAAPI
    // drives opacity + transform on them correctly.
    node.animate(
      [{ opacity: '0', transform: 'scale(.4)' }, { opacity: '1', transform: 'scale(1)' }],
      { duration: 450, delay: delayMs, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'forwards' }
    );
  }

  function drawGraph(svg) {
    svg.innerHTML = '';
    const nodeEls = {};
    const edgeEls = [];
    for (const e of EDGES) {
      const a = byId(e.from);
      const b = byId(e.to);
      const g = el('g', { class: 'gedge', style: 'transform-box:fill-box;transform-origin:center' });
      g.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }));
      const t = el('text', { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 - 8 });
      t.textContent = e.label;
      g.appendChild(t);
      svg.appendChild(g);
      edgeEls.push({ e, g });
    }
    for (const n of NODES) {
      const g = el('g', { class: 'gnode', style: 'transform-box:fill-box;transform-origin:center' });
      g.appendChild(el('circle', { cx: n.x, cy: n.y, r: 44 }));
      const nm = el('text', { x: n.x, y: n.y - 1 });
      nm.setAttribute('class', 'nm');
      nm.textContent = n.label;
      const tp = el('text', { x: n.x, y: n.y + 17 });
      tp.setAttribute('class', 'tp');
      tp.textContent = n.type;
      g.appendChild(nm);
      g.appendChild(tp);
      svg.appendChild(g);
      nodeEls[n.id] = g;
    }
    return { nodeEls, edgeEls };
  }

  function finishInstant(refs) {
    for (const id in refs.nodeEls) refs.nodeEls[id].style.opacity = '1';
    for (const { g } of refs.edgeEls) g.style.opacity = '1';
  }

  function playBuild() {
    const svg = document.getElementById('cv-build');
    const state = document.getElementById('build-state');
    const refs = drawGraph(svg);
    state.textContent = 'NODES';
    if (reduced()) {
      finishInstant(refs);
      state.textContent = '6 + 6';
      return;
    }
    NODES.forEach((n, i) => setTimeout(() => {
      enter(refs.nodeEls[n.id], 0);
      if (i === NODES.length - 1) {
        state.textContent = 'EDGES';
        refs.edgeEls.forEach(({ g }, k) => setTimeout(() => enter(g, 0), k * (beat() / 3)));
        setTimeout(() => { state.textContent = '6 + 6'; }, EDGES.length * (beat() / 3));
      }
    }, i * beat()));
  }

  function playTraverse() {
    const svg = document.getElementById('cv-trav');
    const state = document.getElementById('trav-state');
    const refs = drawGraph(svg);
    finishInstant(refs);
    const hop1 = EDGES.filter((e) => e.from === 'charles');
    const hop2 = EDGES.filter((e) => hop1.some((h) => h.to === e.from) && e.from !== 'charles');
    const light = (ids, edges) => {
      for (const id in refs.nodeEls) refs.nodeEls[id].classList.remove('lit');
      for (const { g } of refs.edgeEls) g.classList.remove('lit');
      ids.forEach((id) => refs.nodeEls[id].classList.add('lit'));
      edges.forEach((i) => refs.edgeEls[i].g.classList.add('lit'));
    };
    const hop1ids = ['charles', ...hop1.map((e) => e.to)];
    const hop1edges = hop1.map((e) => EDGES.indexOf(e));
    const seq = [
      ['HOP 0 · CHARLES', ['charles'], []],
      ['HOP 1 · 4 FOUND', hop1ids, hop1edges],
      ['HOP 2 · EDINBURGH', [...hop1ids, 'edinburgh'], [...hop1edges, 1, 5]],
    ];
    if (reduced()) {
      const last = seq[seq.length - 1];
      light(last[1], last[2]);
      state.textContent = last[0];
      return;
    }
    seq.forEach(([label, ids, edges], k) => setTimeout(() => {
      light(ids, edges);
      state.textContent = label;
    }, k * beat() * 2));
  }

  function playPath() {
    const svg = document.getElementById('cv-path');
    const state = document.getElementById('path-state');
    const refs = drawGraph(svg);
    finishInstant(refs);
    const nodes = ['charles', 'ponti', 'edinburgh'];
    const edges = [0, 1];
    if (reduced()) {
      for (const id in refs.nodeEls) refs.nodeEls[id].classList.add('dim');
      for (const { g } of refs.edgeEls) g.classList.add('dim');
      nodes.forEach((id) => {
        refs.nodeEls[id].classList.remove('dim');
        refs.nodeEls[id].classList.add('lit');
      });
      edges.forEach((i) => {
        refs.edgeEls[i].g.classList.remove('dim');
        refs.edgeEls[i].g.classList.add('lit');
      });
      state.textContent = '2 HOPS';
      return;
    }
    state.textContent = 'BFS…';
    nodes.forEach((id, k) => setTimeout(() => {
      refs.nodeEls[id].classList.add('lit');
      if (k < edges.length) refs.edgeEls[edges[k]].g.classList.add('lit');
      state.textContent = 'DEPTH ' + k;
    }, (k + 1) * beat()));
    setTimeout(() => { state.textContent = '2 HOPS'; }, (nodes.length + 1) * beat());
  }

  window.deckBuild.register({ build: playBuild, traverse: playTraverse, path: playPath });
})();
</script>
