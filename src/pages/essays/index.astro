---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EssayList from "../../components/EssayList";

const essays = await getCollection("essays");
const byNewest = (a: CollectionEntry<"essays">, b: CollectionEntry<"essays">) => {
  if (!a.data.pubDate && !b.data.pubDate) return a.data.title.localeCompare(b.data.title);
  if (!a.data.pubDate) return 1;
  if (!b.data.pubDate) return -1;
  return b.data.pubDate.localeCompare(a.data.pubDate);
};
const sorted = essays.sort(byNewest);

const meta = sorted.map((e: CollectionEntry<"essays">) => ({
  slug: e.data.slug,
  title: e.data.title,
  description: e.data.description,
  category: e.data.category,
  tags: e.data.tags,
  pubDate: e.data.pubDate,
  words: e.data.words,
}));
---

<BaseLayout>
  <main class="mx-auto max-w-2xl px-6 pb-24 pt-20" data-pagefind-ignore>
    <header class="index-hero mb-10" id="hero">
      <h1 class="header-reveal text-[42px] font-medium leading-[1.05] tracking-[-0.02em]" style="--reveal-delay: 0ms">Essays</h1>
      <p class="header-reveal mt-3 text-[15px] text-muted-foreground" style="--reveal-delay: 60ms">
        {sorted.length} longform pieces, from the notebook. The studio's knowledge site — published on the public web.
      </p>
      <p class="header-reveal mt-2 text-[13px] text-muted-foreground/70" style="--reveal-delay: 120ms">
        <a href="/data/" class="press underline decoration-border underline-offset-4 hover:decoration-foreground">
          Corpus data →
        </a>
      </p>
    </header>
    <EssayList essays={meta} client:load />
  </main>
</BaseLayout>