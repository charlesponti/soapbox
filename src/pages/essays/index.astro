---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EssayList from "../../components/EssayList";
import { siteIndex } from "../../lib/registry";

const essays = await getCollection("essays");
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
/* Vault essays + registry: every page is content, newest first. Decks,
   diagrams, deep dives — same list, no separate shelves. */
const meta = siteIndex(essays as CollectionEntry<"essays">[], base);
---

<BaseLayout title="Essays" description="Essays and decks from the notebook." jsonldType="CollectionPage" section="essays">
  <main class="mx-auto max-w-5xl px-6 pb-32 pt-20" data-pagefind-body>
    <header class="mb-14">
      <h1 class="header-reveal text-[clamp(38px,6vw,64px)] font-bold leading-[1] tracking-[-0.035em]" style="--reveal-delay: 0ms">
        Essays
      </h1>
      <p class="header-reveal mt-4 max-w-2xl text-[17px] text-muted-foreground" style="--reveal-delay: 60ms">
        Long-form thinking from the notebook — reading and decks, one list.
      </p>
    </header>

    <section>
      <h2 class="mb-5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
        All content · {meta.length}
      </h2>
      <EssayList essays={meta} base={base} client:idle />
    </section>
  </main>
</BaseLayout>
