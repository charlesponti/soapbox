---
import Deck from '../../layouts/Deck.astro';
---
<Deck title="Entity Extraction" brand="ENTITY EXTRACTION" series="SEME · DIAGRAM 03" replayHint={true}
  category="technology"
  description="Raw text in, typed entities out, duplicates merged, graph committed. No dictionary involved.">
<deck-cue time="COVER" title="The title">Open on the title. Raw text in, graph out — and no dictionary anywhere. Step into the raw sentence.</deck-cue>
<deck-cue time="STEP 1 · RAW" title="One sentence">A single sentence carries a person, a place, an org, a topic and a dog. Watch it arrive one character at a time.</deck-cue>
<deck-cue time="STEP 2 · CHUNKS" title="Batches">Long input is sliced into batches of six turns so every model call stays inside a reliable window.</deck-cue>
<deck-cue time="STEP 3 · JSON" title="Strict schema">The model returns entities, relations and memories in strict JSON. Fences stripped before parsing.</deck-cue>
<deck-cue time="STEP 4 · RESOLVED" title="The merge">Two Charleses walk in. The duplicate is flagged, folded into the existing node, and gone — count kept.</deck-cue>
<deck-cue time="STEP 5 · GRAPH" title="Committed">Five nodes, three edges, in SQLite. Recursive CTEs will walk it later without a graph database.</deck-cue>
<deck-cue time="CLOSE" title="No dictionary">Free-form types: a new domain brings its own vocabulary. The types arrive with the text.</deck-cue>

<deck-scene id="s0" title="SEME · DIAGRAM 03" layout="full" cover>
<h1 class="rise">Entity Extraction</h1>
<p class="lede rise">Raw text in. Graph out.</p>
</deck-scene>

<deck-scene id="s1" title="RAW" layout="split"><div>
<h2 class="rise">Start with<br><em class="serif">a sentence.</em></h2>
<p class="lede rise">One sentence carries a person, a place, an org, a topic — and a dog.</p>
<button class="replay rise" data-replay="raw"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE SENTENCE</button></div>
<div class="diagram rise"><div class="dlabel"><span>INPUT</span><span>RAW TEXT</span></div>
<p class="raw" id="raw-text"></p>
<p class="note">Everything downstream starts here.</p></div></deck-scene>

<deck-scene id="s2" title="CHUNKS" layout="split"><div>
<h2 class="rise">Slice into<br><em class="serif">batches.</em></h2>
<p class="lede rise">Six turns per batch. Every model call stays inside a reliable window.</p>
<button class="replay rise" data-replay="chunks"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE SPLIT</button></div>
<div class="diagram rise"><div class="dlabel"><span>CHUNKED</span><span>3 BATCHES</span></div>
<div class="res" id="res-chunks"></div>
<p class="note">Long input fans out; results merge back.</p></div></deck-scene>

<deck-scene id="s3" title="JSON" layout="split"><div>
<h2 class="rise">Strict schema<br><em class="serif">out.</em></h2>
<p class="lede rise">Entities with free-form types. Relations as source, arrow, target.</p>
<button class="replay rise" data-replay="json"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE RETURN</button></div>
<div class="diagram rise"><div class="dlabel"><span>LLM EXTRACTION</span><span>JSON</span></div>
<pre class="json" id="res-json">waiting…</pre>
<p class="note">Markdown fences stripped before parsing.</p></div></deck-scene>

<deck-scene id="s4" title="RESOLVED" layout="split"><div>
<h2 class="rise">Two Charleses walk in.<br><em class="serif">One walks out.</em></h2>
<p class="lede rise">Names normalised, duplicates merged. Mention counts survive.</p>
<button class="replay rise" data-replay="resolve"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE MERGE</button></div>
<div class="diagram rise"><div class="dlabel"><span>RESOLUTION</span><span>5 KEPT · 1 MERGED</span></div>
<div class="pills" id="res-ents"></div>
<p class="note" id="merge-note">The duplicate is flagged, folded in, gone.</p></div></deck-scene>

<deck-scene id="s5" title="GRAPH" layout="split"><div>
<h2 class="rise">Committed<br><em class="serif">to SQLite.</em></h2>
<p class="lede rise">Five nodes, three edges. No graph database required.</p>
<button class="replay rise" data-replay="graph"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE WRITE</button></div>
<div class="diagram rise"><div class="dlabel"><span>GRAPH WRITTEN</span><span>NODES + EDGES</span></div>
<pre class="json" id="res-graph">waiting…</pre>
<p class="note">Recursive CTEs walk it later, in pure SQL.</p></div></deck-scene>

<deck-scene id="s6" title="CLOSE" layout="full">
<div class="finish serif rise">No dictionary. The types arrive with the text.</div>
<p class="lede rise" style="margin-top:26px">The deep dive sits under Essays, Entity Extraction.</p>
</deck-scene>
</Deck>

<style is:inline slot="head">
.res{margin-top:6px;min-height:60px}
.raw{font-family:var(--mono);font-size:15px;line-height:1.7;min-height:88px;color:var(--ink)}
.chip{display:inline-block;border:1px solid #333;border-radius:8px;padding:10px 14px;margin:0 8px 8px 0;font-size:13px;background:var(--panel)}
.json{font-family:var(--mono);font-size:12px;line-height:1.65;background:#0d0d0d;border:1px solid var(--line);border-radius:8px;padding:14px 16px;overflow-x:auto;white-space:pre}
.pills{display:flex;flex-wrap:wrap;gap:8px;min-height:60px;margin-top:6px}
.pill{border:1px solid #333;border-radius:999px;padding:7px 14px;font-size:13px;background:var(--panel)}
.pill small{font-family:var(--mono);font-size:10px;color:var(--g1);margin-left:8px;letter-spacing:.08em}
.pill.merge{border:2px dashed #E4181B}
.pill.gone{opacity:0;transform:scale(.6)}
</style>

<!--
ACCENT AUDIT (SYSTEM.md §2): the dashed red merge outline is the one semantic
state of this deck — the duplicate being folded away. Everything else is
monochrome. The nav mark is the shared brand component owned by
components/deck-stage.js.
-->

<script is:inline slot="script">
/* One script, one declaration of everything. The stage fires each scene's
   builder on first view and on R. */
(function () {
  const beat = () => window.DECK_BEAT || 900;
  const reduced = () => !!window.deckBuild.reduced;
  const motion = () => window.deckBuild.Motion;
  const RAW = 'My name is Charles and I live in London. I work at Ponti Studios building iOS apps. I have a dog named Cyndi.';
  const CHUNKS = [
    'My name is Charles and I live in London.',
    'I work at Ponti Studios building iOS apps.',
    'I have a dog named Cyndi.',
  ];
  const JSON_OUT = [
    '{ "entities": [',
    '  { "name": "Charles", "type": "person" },',
    '  { "name": "London", "type": "place" },',
    '  { "name": "Ponti Studios", "type": "org" },',
    '  { "name": "iOS app development", "type": "topic" },',
    '  { "name": "Cyndi", "type": "animal" } ],',
    '  "relations": [ lives_in, works_at, owns ] }',
  ].join('\n');
  const GRAPH_OUT = [
    'nodes: 5   edges: 3',
    '',
    'Charles ──lives_in──▶ London',
    '        ──works_at──▶ Ponti Studios',
    '        ──owns──────▶ Cyndi'
  ].join('\n');
  const ENTS = [
    { name: 'Charles', type: 'person' },
    { name: 'London', type: 'place' },
    { name: 'Ponti Studios', type: 'org' },
    { name: 'iOS app development', type: 'topic' },
    { name: 'Cyndi', type: 'animal' },
    { name: 'Charles', type: 'person', merge: true },
  ];

  function enter(el, delayMs) {
    const M = motion();
    if (reduced() || !M) return;
    M.animate(el, { opacity: [0, 1], y: [8, 0] }, { duration: 0.4, delay: delayMs / 1000, ease: [0.22, 1, 0.36, 1] });
  }

  function playRaw() {
    const el = document.getElementById('raw-text');
    el.textContent = '';
    if (reduced()) {
      el.textContent = RAW;
      return;
    }
    let i = 0;
    const tick = () => {
      i += 2;
      el.textContent = RAW.slice(0, i);
      if (i < RAW.length) setTimeout(tick, 18);
    };
    tick();
  }

  function playChunks() {
    const box = document.getElementById('res-chunks');
    box.innerHTML = '';
    CHUNKS.forEach((c, i) => {
      const show = () => {
        const s = document.createElement('span');
        s.className = 'chip';
        s.textContent = c;
        box.appendChild(s);
        enter(s, 0);
      };
      if (reduced()) show();
      else setTimeout(show, i * beat());
    });
  }

  function playJson() {
    const el = document.getElementById('res-json');
    el.textContent = 'waiting…';
    if (reduced()) {
      el.textContent = JSON_OUT;
      return;
    }
    setTimeout(() => {
      el.textContent = JSON_OUT;
      enter(el, 0);
    }, beat());
  }

  function playResolve() {
    const box = document.getElementById('res-ents');
    const note = document.getElementById('merge-note');
    box.innerHTML = '';
    note.textContent = 'Names normalised, duplicates flagged.';
    ENTS.forEach((e, i) => {
      const show = () => {
        const p = document.createElement('span');
        p.className = 'pill';
        p.textContent = e.name;
        const t = document.createElement('small');
        t.textContent = e.type.toUpperCase();
        p.appendChild(t);
        box.appendChild(p);
        enter(p, 0);
        if (e.merge) {
          const flag = () => {
            p.classList.add('merge');
            note.textContent = 'Duplicate "Charles" — merged into the existing node, mention_count + 1.';
            setTimeout(() => {
              p.classList.add('gone');
              setTimeout(() => p.remove(), 350);
            }, reduced() ? 0 : beat());
          };
          if (reduced()) flag();
          else setTimeout(flag, beat());
        }
      };
      if (reduced()) show();
      else setTimeout(show, i * (beat() / 2));
    });
  }

  function playGraph() {
    const el = document.getElementById('res-graph');
    el.textContent = 'waiting…';
    if (reduced()) {
      el.textContent = GRAPH_OUT;
      return;
    }
    setTimeout(() => {
      el.textContent = GRAPH_OUT;
      enter(el, 0);
    }, beat());
  }

  window.deckBuild.register({
    raw: playRaw,
    chunks: playChunks,
    json: playJson,
    resolve: playResolve,
    graph: playGraph,
  });
})();
</script>
