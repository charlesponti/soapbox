---
import Deck from '../../layouts/Deck.astro';
---
<Deck title="KB Intelligence" brand="KB INTELLIGENCE" series="SEME · DIAGRAM 06" replayHint={true}
  category="technology"
  description="Contradictions caught, newer claims superseding older ones, patterns surfacing across memories. Linting observes; resolution acts.">
<deck-cue time="COVER" title="The title">Open on the title. The knowledge base audits itself: conflicts, supersession, patterns. Start with four innocent claims.</deck-cue>
<deck-cue time="STEP 1 · CLAIMS" title="Four claims">Four stored claims, two pairs sharing a slot. Nothing looks wrong yet.</deck-cue>
<deck-cue time="STEP 2 · CONFLICTS" title="Flagged">Same slot, different value, both user-stated: genuine conflict. Flag both pairs red.</deck-cue>
<deck-cue time="STEP 3 · RESOLVED" title="Superseded">Newer wins. The old row keeps its valid_to — the history of belief stays auditable. Nothing is overwritten.</deck-cue>
<deck-cue time="STEP 4 · PATTERN" title="The bridge">Four memories, one recurring concern, one bridging entity. Promote it.</deck-cue>
<deck-cue time="CLOSE" title="Observe, act">Linting observes, resolution acts, and both keep the trail intact.</deck-cue>

<deck-scene id="s0" title="SEME · DIAGRAM 06" layout="full" cover>
<h1 class="rise">KB Intelligence</h1>
<p class="lede rise">Catch the contradiction. Keep the history.</p>
</deck-scene>

<deck-scene id="s1" title="CLAIMS" layout="split"><div>
<h2 class="rise">Four claims<br><em class="serif">walk in.</em></h2>
<p class="lede rise">Stored beliefs, each with provenance. Nothing looks wrong yet.</p>
<button class="replay rise" data-replay="claims"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE CLAIMS</button></div>
<div class="diagram rise"><div class="dlabel"><span>STORED CLAIMS</span><span>4 BELIEFS</span></div>
<div class="res" id="res-claims"></div>
<p class="note">Two pairs share a slot. That is the whole tripwire.</p></div></deck-scene>

<deck-scene id="s2" title="CONFLICTS" layout="split"><div>
<h2 class="rise">Same slot.<br><em class="serif">Different value.</em></h2>
<p class="lede rise">Both user-stated, both live: genuine conflict, not an addition.</p>
<button class="replay rise" data-replay="conflicts"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE FLAGS</button></div>
<div class="diagram rise"><div class="dlabel"><span>VERIFICATION</span><span>2 CONFLICTS</span></div>
<div class="res" id="res-conf"></div>
<p class="note">Flagged, never silently overwritten.</p></div></deck-scene>

<deck-scene id="s3" title="RESOLVED" layout="split"><div>
<h2 class="rise">Newer wins.<br><em class="serif">Nothing deleted.</em></h2>
<p class="lede rise">The old row keeps its valid_to. The history of belief stays auditable.</p>
<button class="replay rise" data-replay="resolve"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE RESOLUTION</button></div>
<div class="diagram rise"><div class="dlabel"><span>SUPERSESSION</span><span>HISTORY KEPT</span></div>
<div class="res" id="res-res"></div>
<p class="note">Superseded, not erased: valid_to set, row kept.</p></div></deck-scene>

<deck-scene id="s4" title="PATTERN" layout="split"><div>
<h2 class="rise">Four memories.<br><em class="serif">One bridge.</em></h2>
<p class="lede rise">Retrieval quality keeps recurring. One entity links every topic.</p>
<button class="replay rise" data-replay="pattern"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE PATTERN</button></div>
<div class="diagram rise"><div class="dlabel"><span>EMERGENT PATTERN</span><span>CO-OCCURRENCE</span></div>
<div class="res" id="res-pat"></div>
<p class="note">Mentioned in three unrelated topics. Promoted.</p></div></deck-scene>

<deck-scene id="s5" title="CLOSE" layout="full">
<div class="finish serif rise">Linting observes. Resolution acts.</div>
<p class="lede rise" style="margin-top:26px">Five passive checks score the base; conflicts resolve with the trail intact. The deep dive sits under Essays, KB Intelligence.</p>
</deck-scene>
</Deck>

<style is:inline slot="head">
.res{margin-top:6px;min-height:120px}
.claim{border:1px solid var(--line);border-radius:8px;background:var(--panel);padding:11px 14px;margin:8px 0;font-size:14px}
.claim .src{font-family:var(--mono);font-size:11px;color:var(--g1);margin-top:5px}
.claim .tag{float:right;font-family:var(--mono);font-size:10px;letter-spacing:.1em;border:1px solid #333;border-radius:999px;padding:3px 9px;color:var(--g1)}
.claim.conf{border-color:#E4181B}
.claim.conf .tag{background:#E4181B;border-color:#E4181B;color:#fff}
.claim.old{opacity:.55;border-style:dashed}
.claim.old .tag{border-color:#fff;color:#fff}
.pat{border:1px dashed #333;border-radius:10px;padding:14px;background:var(--panel);font-size:14px;line-height:1.6}
.pat b{color:#fff}
.pat .kick{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--g1);display:block;margin-bottom:8px}
</style>

<!--
ACCENT AUDIT (SYSTEM.md §2): conflict flags (#E4181B) are the one semantic
state of this deck — a live contradiction. Resolved states are monochrome
(dim + white tags). The nav mark is the shared brand component owned by
components/deck-stage.js.
-->

<script is:inline slot="script">
/* One script, one declaration of everything. The stage fires each scene's
   builder on first view and on R. Each phase rebuilds from a clean state so
   replay and direct entry always tell the full story so far. */
(function () {
  const beat = () => window.DECK_BEAT || 900;
  const reduced = () => !!window.deckBuild.reduced;
  const motion = () => window.deckBuild.Motion;
  const CLAIMS = [
    { text: 'The API rate limit is 1000 requests/min.', src: 'user · 3 weeks ago' },
    { text: 'The API rate limit is now 5000 requests/min.', src: 'user · today' },
    { text: 'The Q2 launch is April 15.', src: 'meeting notes · March' },
    { text: 'The Q2 launch slipped to May 8 after legal review.', src: 'email · today' },
  ];

  function enter(el, delayMs) {
    const M = motion();
    if (reduced() || !M) return;
    M.animate(el, { opacity: [0, 1], y: [8, 0] }, { duration: 0.4, delay: delayMs / 1000, ease: [0.22, 1, 0.36, 1] });
  }

  function claimRow(c) {
    const el = document.createElement('div');
    el.className = 'claim';
    const tag = document.createElement('span');
    tag.className = 'tag';
    tag.textContent = '—';
    const body = document.createElement('div');
    body.textContent = c.text;
    const src = document.createElement('div');
    src.className = 'src';
    src.textContent = c.src;
    el.appendChild(tag);
    el.appendChild(body);
    el.appendChild(src);
    el._tag = tag;
    return el;
  }

  function playClaims() {
    const box = document.getElementById('res-claims');
    box.innerHTML = '';
    CLAIMS.forEach((c, i) => {
      const show = () => {
        const r = claimRow(c);
        box.appendChild(r);
        enter(r, 0);
      };
      if (reduced()) show();
      else setTimeout(show, i * (beat() / 2));
    });
  }

  function playConflicts() {
    const box = document.getElementById('res-conf');
    box.innerHTML = '';
    const rows = CLAIMS.map((c) => {
      const r = claimRow(c);
      box.appendChild(r);
      return r;
    });
    playConflictsOn(rows, [[0, 1], [2, 3]]);
  }

  function flagPair(rows, a, b) {
    [a, b].forEach((i) => {
      rows[i].classList.add('conf');
      rows[i]._tag.textContent = 'CONFLICT';
    });
  }

  function settlePair(rows, a, b) {
    rows[a].classList.add('old');
    rows[a]._tag.textContent = 'SUPERSEDED';
    rows[b]._tag.textContent = 'CURRENT';
  }

  function playConflictsOn(rows, pairs, done) {
    if (reduced()) {
      pairs.forEach(([a, b]) => flagPair(rows, a, b));
      if (done) done();
      return;
    }
    pairs.forEach(([a, b], k) => setTimeout(() => {
      flagPair(rows, a, b);
      if (done && k === pairs.length - 1) setTimeout(done, beat());
    }, (k + 1) * beat()));
  }

  function playResolve() {
    const box = document.getElementById('res-res');
    box.innerHTML = '';
    const rows = CLAIMS.map((c) => {
      const r = claimRow(c);
      box.appendChild(r);
      return r;
    });
    const pairs = [[0, 1], [2, 3]];
    if (reduced()) {
      pairs.forEach(([a, b]) => {
        flagPair(rows, a, b);
        settlePair(rows, a, b);
      });
      return;
    }
    playConflictsOn(rows, pairs, () => pairs.forEach(([a, b], k) =>
      setTimeout(() => settlePair(rows, a, b), k * beat())));
  }

  function playPattern() {
    const box = document.getElementById('res-pat');
    box.innerHTML = '';
    if (reduced()) {
      box.appendChild(patternEl());
      return;
    }
    setTimeout(() => {
      const el = patternEl();
      box.appendChild(el);
      enter(el, 0);
    }, beat());
  }

  function patternEl() {
    const el = document.createElement('div');
    el.className = 'pat';
    const kick = document.createElement('span');
    kick.className = 'kick';
    kick.textContent = 'PATTERN SURFACED';
    const body = document.createElement('div');
    const b = document.createElement('b');
    b.textContent = 'hybrid search';
    body.appendChild(document.createTextNode('Across 4 memories, retrieval quality is the recurring concern. Bridging entity: '));
    body.appendChild(b);
    body.appendChild(document.createTextNode(' — mentioned in three unrelated topics.'));
    el.appendChild(kick);
    el.appendChild(body);
    return el;
  }

  window.deckBuild.register({
    claims: playClaims,
    conflicts: playConflicts,
    resolve: playResolve,
    pattern: playPattern,
  });
})();
</script>
