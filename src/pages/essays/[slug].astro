---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { relatedTo, type EssayEntry } from "../../lib/related-essays";

export async function getStaticPaths() {
  const essays = await getCollection("essays");
  return essays.map((entry: EssayEntry) => ({
    params: { slug: entry.data.slug },
    props: { entry, related: relatedTo(entry, essays) },
  }));
}

interface Props {
  entry: EssayEntry;
  related: EssayEntry[];
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { title, description, tags, category } = entry.data;
---

<BaseLayout
  title={`${title} — Essays`}
  description={description || undefined}
  jsonldType="Article"
  section="essays"
>
  <main
    class="mx-auto max-w-2xl px-6 pb-28 pt-20"
    data-pagefind-body
    data-pagefind-filter={`category:${category}`}
  >
    <a
      href="../"
      data-pagefind-ignore
      class="press fixed left-5 top-5 z-30 inline-flex items-center gap-1.5 rounded-full border border-border bg-background/85 px-3.5 py-1.5 text-sm text-muted-foreground backdrop-blur hover:border-foreground/40 hover:text-foreground"
    >
      ← Back
    </a>

    <header class="mb-14">
      <div class="header-reveal font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground" style="--reveal-delay: 0ms">{category}</div>
      <h1 class="header-reveal mt-3 text-[34px] font-medium leading-[1.1] tracking-[-0.02em] text-balance sm:text-[40px]" style="--reveal-delay: 60ms">{title}</h1>
      {description && <p class="header-reveal mt-4 text-lg leading-relaxed text-muted-foreground" style="--reveal-delay: 120ms">{description}</p>}
      {tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.map((t: string, i: number) => (
            <li
              class="tag-pill rounded-full border border-border px-3 py-0.5 text-xs text-muted-foreground"
              style={`--reveal-delay: ${140 + Math.min(i, 8) * 40}ms`}
            >
              {t}
            </li>
          ))}
        </ul>
      )}
    </header>

    <article class="prose max-w-[65ch]">
      <Content />
    </article>

    {related.length > 0 && (
      <aside class="mt-20 border-t border-border pt-10" aria-label="Keep reading">
        <h2 class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Keep reading
        </h2>
        <a
          href={`../${related[0]!.data.slug}/`}
          class="group block py-5"
        >
          <span class="block text-[24px] font-semibold leading-snug tracking-[-0.02em]"><span class="row-title">{related[0]!.data.title}</span></span>
          {related[0]!.data.description && (
            <span class="mt-1 block max-w-[52ch] text-[15px] leading-relaxed text-muted-foreground">{related[0]!.data.description}</span>
          )}
          <span class="mt-2 block font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">Next essay <span aria-hidden="true">→</span></span>
        </a>
        {related.length > 1 && (
          <ul class="mt-2 space-y-1 border-t border-border/60 pt-4">
            {related.slice(1).map((r: EssayEntry) => (
              <li>
                <a
                  href={`../${r.data.slug}/`}
                  class="group -mx-3 flex items-baseline justify-between gap-6 rounded-md px-3 py-3 transition-colors hover:bg-muted/70"
                >
                  <span class="block text-[16px] font-medium leading-snug tracking-[-0.01em] group-hover:underline group-hover:underline-offset-4">
                    {r.data.title}
                  </span>
                  <span class="shrink-0 text-[13px] text-muted-foreground">{r.data.category}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </aside>
    )}
  </main>
</BaseLayout>
