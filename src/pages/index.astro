---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import manifest from "../../decks.json";

const byNewest = (a: CollectionEntry<"essays">, b: CollectionEntry<"essays">) => {
  if (!a.data.pubDate && !b.data.pubDate) return a.data.title.localeCompare(b.data.title);
  if (!a.data.pubDate) return 1;
  if (!b.data.pubDate) return -1;
  return b.data.pubDate.localeCompare(a.data.pubDate);
};
const all = (await getCollection("essays")).sort(byNewest);
const essays = all.slice(0, 3);
const decks = [...manifest.decks].sort((a, b) => b.episode - a.episode).slice(0, 3);
---

<BaseLayout title="Soapbox" description="Essays and full-screen decks.">
  <canvas id="universe" aria-hidden="true"></canvas>
  <main class="home mx-auto max-w-5xl px-6 pb-32 pt-20" data-pagefind-ignore>
    <!-- Hero -->
    <header class="mb-24 relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3.5 py-1.5 text-xs text-muted-foreground backdrop-blur mb-8">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Now writing · {all.length} essays published
      </div>
      <h1 class="text-[clamp(48px,8vw,96px)] font-bold leading-[0.95] tracking-[-0.04em]">
        <span class="block">Ideas that</span>
        <span class="block bg-gradient-to-r from-white via-zinc-300 to-zinc-500 bg-clip-text text-transparent">
          refuse to stay quiet.
        </span>
      </h1>
      <p class="mt-8 max-w-2xl text-[18px] leading-relaxed text-muted-foreground">
        Essays from the notebook, and full-screen decks talked over. Same head, two formats —
        long-form thinking you can read, or listen to while you work.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/essays/" class="inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background hover:opacity-90 transition-opacity">
          Read essays →
        </a>
        <a href="/decks/" class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-6 py-3 text-sm font-medium text-foreground hover:border-foreground/40 transition-colors backdrop-blur">
          Watch decks →
        </a>
      </div>
    </header>

    <!-- Stats -->
    <section class="mb-24 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-2xl border border-border bg-card/40 p-6 backdrop-blur">
        <div class="text-[32px] font-bold tracking-tight">{all.length}</div>
        <div class="mt-1 text-[13px] text-muted-foreground">Essays published</div>
      </div>
      <div class="rounded-2xl border border-border bg-card/40 p-6 backdrop-blur">
        <div class="text-[32px] font-bold tracking-tight">{manifest.decks.length}</div>
        <div class="mt-1 text-[13px] text-muted-foreground">Decks recorded</div>
      </div>
      <div class="rounded-2xl border border-border bg-card/40 p-6 backdrop-blur">
        <div class="text-[32px] font-bold tracking-tight">∞</div>
        <div class="mt-1 text-[13px] text-muted-foreground">Ideas in the queue</div>
      </div>
      <div class="rounded-2xl border border-border bg-card/40 p-6 backdrop-blur">
        <div class="text-[32px] font-bold tracking-tight">1</div>
        <div class="mt-1 text-[13px] text-muted-foreground">Head, two formats</div>
      </div>
    </section>

    <!-- Latest essays -->
    <section class="mb-24">
      <div class="mb-8 flex items-baseline justify-between">
        <h2 class="text-[13px] uppercase tracking-[0.14em] text-muted-foreground">Latest essays</h2>
        <a href="/essays/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">All {all.length} →</a>
      </div>
      <ul class="grid gap-4">
        {essays.map((e: CollectionEntry<"essays">) => (
          <li>
            <a href={`/essays/${e.data.slug}/`} class="card press group block rounded-2xl border border-border p-6 hover:border-foreground/30 transition-all">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <div class="text-[20px] font-semibold leading-snug group-hover:text-white transition-colors">{e.data.title}</div>
                  {e.data.description && <p class="mt-2 text-[14px] leading-relaxed text-muted-foreground">{e.data.description}</p>}
                </div>
                <div class="shrink-0 text-muted-foreground/40 group-hover:text-muted-foreground transition-colors text-lg">→</div>
              </div>
              <div class="mt-4 flex items-center gap-2 text-[12px] text-muted-foreground/60">
                {e.data.category && <span class="rounded-full bg-accent px-2.5 py-0.5">{e.data.category}</span>}
                {e.data.pubDate && <span>{e.data.pubDate.slice(0, 10)}</span>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Latest decks -->
    <section class="mb-24">
      <div class="mb-8 flex items-baseline justify-between">
        <h2 class="text-[13px] uppercase tracking-[0.14em] text-muted-foreground">Latest decks</h2>
        <a href="/decks/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">All decks →</a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-3">
        {decks.map((d) => (
          <li>
            <a href={`/decks/${d.slug}/`} class="card press group block overflow-hidden rounded-2xl border border-border hover:border-foreground/30 transition-all">
              <img src={`/og/${d.slug}.png`} alt="" width="1200" height="630" loading="lazy" class="aspect-[1200/630] w-full object-cover" />
              <div class="p-5">
                <div class="text-[11px] tracking-[0.12em] text-muted-foreground/70 uppercase">{d.series}</div>
                <div class="mt-1.5 text-[16px] font-semibold leading-snug group-hover:text-white transition-colors">{d.title}</div>
                <p class="mt-1.5 text-[13px] leading-relaxed text-muted-foreground">{d.summary}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- CTA -->
    <section class="rounded-3xl border border-border bg-gradient-to-b from-card/60 to-transparent p-12 text-center backdrop-blur">
      <h2 class="text-[32px] font-bold tracking-tight">Your knowledge deserves better than bookmarks.</h2>
      <p class="mt-4 mx-auto max-w-lg text-[16px] text-muted-foreground">
        Long-form thinking, distilled into essays and decks. No noise, no algorithm — just ideas that matter.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/essays/" class="inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background hover:opacity-90 transition-opacity">
          Start reading
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  #universe {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 120%, #14141f 0%, #0a0a0a 60%);
  }
  .home { position: relative; }
  .card { background: rgb(10 10 10 / 0.6); backdrop-filter: blur(6px); transition: border-color 0.2s, transform 0.2s; }
  .card:hover { border-color: rgb(250 250 250 / 0.3); transform: translateY(-2px); }
  .press { transition: transform 0.1s ease; }
  .press:active { transform: scale(0.98); }
</style>

<script>
  // Drifting starfield with depth: stars fly slowly toward the viewer, a few tint blue/warm.
  function start() {
    const canvas = document.getElementById("universe") as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tints = ["250,250,250", "170,190,255", "255,220,180"];
    type Star = { x: number; y: number; z: number; t: string };
    let w = 0, h = 0, stars: Star[] = [], raf = 0;
    const spawn = (z = Math.random()): Star => ({
      x: (Math.random() - 0.5) * 2,
      y: (Math.random() - 0.5) * 2,
      z,
      t: tints[Math.floor(Math.random() * tints.length)]!,
    });
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.width = innerWidth * dpr;
      h = canvas.height = innerHeight * dpr;
      stars = Array.from({ length: Math.round((innerWidth * innerHeight) / 5000) }, () => spawn());
    };
    const draw = (move: boolean) => {
      ctx.clearRect(0, 0, w, h);
      const s = Math.max(w, h) / 2;
      for (const st of stars) {
        if (move) {
          st.z -= 0.0008;
          if (st.z <= 0.02) Object.assign(st, spawn(1));
        }
        const k = 1 / st.z;
        const px = w / 2 + st.x * s * 0.35 * k;
        const py = h / 2 + st.y * s * 0.35 * k;
        if (px < 0 || px > w || py < 0 || py > h) { if (move) Object.assign(st, spawn(1)); continue; }
        const r = Math.min(2.2, 0.7 + k * 0.18) * (w / innerWidth);
        ctx.fillStyle = `rgba(${st.t},${Math.min(1, 1.1 - st.z * 0.5)})`;
        ctx.beginPath();
        ctx.arc(px, py, r, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    const loop = () => { draw(true); raf = requestAnimationFrame(loop); };
    resize();
    addEventListener("resize", resize);
    if (reduced) draw(false);
    else loop();
    document.addEventListener("astro:before-swap", () => { cancelAnimationFrame(raf); removeEventListener("resize", resize); }, { once: true });
  }
  start();
</script>