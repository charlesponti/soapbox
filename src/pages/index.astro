---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EssayList from "../components/EssayList";
import { siteIndex } from "../lib/registry";

const essays = await getCollection("essays");
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
/* Vault essays + registry (essays, decks, diagrams): one list, newest first.
   The old /essays index is gone — this IS the index. */
const meta = siteIndex(essays as CollectionEntry<"essays">[], base);
---

<BaseLayout title="Soapbox" description="Essays and full-screen decks.">
  <canvas id="universe" aria-hidden="true"></canvas>
  <main class="home mx-auto max-w-5xl px-6 pb-32 pt-20 sm:pt-28" data-pagefind-ignore>
    <h1 class="header-reveal" style="--reveal-delay: 0ms">
      Ideas that refuse to stay quiet.
    </h1>
    <p class="home-lede header-reveal" style="--reveal-delay: 60ms">
      Long-form thinking from the notebook, plus full-screen decks — one list,
      newest first.
    </p>
    <EssayList essays={meta} base={base} client:idle />
  </main>
</BaseLayout>

<style>
  #universe {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: #000;
  }
  .home { position: relative; }
  .home h1 {
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 800;
    text-wrap: balance;
    margin: 0 0 1rem;
  }
  .home-lede {
    margin: 0 0 3.5rem;
    max-width: 42rem;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }
</style>

<script>
  // Drifting starfield with depth: stars fly slowly toward the viewer. Depth is
  // carried by brightness only (white → grey), never colour.
  function start() {
    const canvas = document.getElementById("universe") as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tints = ["250,250,250", "210,210,210", "160,160,160"];
    type Star = { x: number; y: number; z: number; t: string };
    let w = 0, h = 0, stars: Star[] = [], raf = 0;
    const spawn = (z = Math.random()): Star => ({
      x: (Math.random() - 0.5) * 2,
      y: (Math.random() - 0.5) * 2,
      z,
      t: tints[Math.floor(Math.random() * tints.length)]!,
    });
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.width = innerWidth * dpr;
      h = canvas.height = innerHeight * dpr;
      stars = Array.from({ length: Math.round((innerWidth * innerHeight) / 5000) }, () => spawn());
    };
    const draw = (move: boolean) => {
      ctx.clearRect(0, 0, w, h);
      const s = Math.max(w, h) / 2;
      for (const st of stars) {
        if (move) {
          st.z -= 0.0008;
          if (st.z <= 0.02) Object.assign(st, spawn(1));
        }
        const k = 1 / st.z;
        const px = w / 2 + st.x * s * 0.35 * k;
        const py = h / 2 + st.y * s * 0.35 * k;
        if (px < 0 || px > w || py < 0 || py > h) { if (move) Object.assign(st, spawn(1)); continue; }
        const r = Math.min(2.2, 0.7 + k * 0.18) * (w / innerWidth);
        ctx.fillStyle = `rgba(${st.t},${Math.min(1, 1.1 - st.z * 0.5)})`;
        ctx.beginPath();
        ctx.arc(px, py, r, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    const loop = () => { draw(true); raf = requestAnimationFrame(loop); };
    resize();
    addEventListener("resize", resize);
    if (reduced) draw(false);
    else loop();
    document.addEventListener("astro:before-swap", () => { cancelAnimationFrame(raf); removeEventListener("resize", resize); }, { once: true });
  }
  start();
</script>
