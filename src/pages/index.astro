---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { compareNewest } from "../lib/registry";
import manifest from "../../decks.json";

const all = (await getCollection("essays")).sort(
  (a: CollectionEntry<"essays">, b: CollectionEntry<"essays">) => compareNewest(a.data, b.data),
);
const ordered = [...manifest.decks].sort((a, b) => a.episode - b.episode);

interface Row {
  title: string;
  url: string;
  tag: string;
}
const rows: Row[] = [
  ...ordered.map((d) => ({
    title: d.title,
    url: `decks/${d.slug}/`,
    tag: d.series,
  })),
  ...all.map((e: CollectionEntry<"essays">) => ({
    title: e.data.title,
    url: `essays/${e.data.slug}/`,
    tag: e.data.category,
  })),
];
---

<BaseLayout title="Soapbox" description="Essays and full-screen decks.">
  <canvas id="universe" aria-hidden="true"></canvas>
  <main class="home mx-auto max-w-3xl px-6 pb-32 pt-20 sm:pt-28" data-pagefind-ignore>
    <h1 class="header-reveal" style="--reveal-delay: 0ms">
      Ideas that refuse to stay quiet.
    </h1>
    <ol class="idx">
      {rows.map((r, i) => (
        <li>
          <a href={r.url} class="group">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <span class="t"><span class="row-title">{r.title}</span></span>
            <span class="c">{r.tag}</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>

<style>
  #universe {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 120%, #14141f 0%, #0a0a0a 60%);
  }
  .home { position: relative; }
  .home h1 {
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 800;
    text-wrap: balance;
    margin: 0 0 3.5rem;
  }
  .idx { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .idx a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-foreground);
  }
  .idx a:hover { background: rgb(13 13 13 / 0.8); }
  .idx .n { font-family: var(--font-mono); font-size: 12px; color: var(--color-g2, #737373); }
  .idx .t { font-size: 19px; font-weight: 600; letter-spacing: -0.015em; }
  .idx .c {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-g2, #737373);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .idx a { grid-template-columns: 2.25rem minmax(0, 1fr); }
    .idx .c { display: none; }
  }
</style>

<script>
  // Drifting starfield with depth: stars fly slowly toward the viewer, a few tint blue/warm.
  function start() {
    const canvas = document.getElementById("universe") as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tints = ["250,250,250", "170,190,255", "255,220,180"];
    type Star = { x: number; y: number; z: number; t: string };
    let w = 0, h = 0, stars: Star[] = [], raf = 0;
    const spawn = (z = Math.random()): Star => ({
      x: (Math.random() - 0.5) * 2,
      y: (Math.random() - 0.5) * 2,
      z,
      t: tints[Math.floor(Math.random() * tints.length)]!,
    });
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.width = innerWidth * dpr;
      h = canvas.height = innerHeight * dpr;
      stars = Array.from({ length: Math.round((innerWidth * innerHeight) / 5000) }, () => spawn());
    };
    const draw = (move: boolean) => {
      ctx.clearRect(0, 0, w, h);
      const s = Math.max(w, h) / 2;
      for (const st of stars) {
        if (move) {
          st.z -= 0.0008;
          if (st.z <= 0.02) Object.assign(st, spawn(1));
        }
        const k = 1 / st.z;
        const px = w / 2 + st.x * s * 0.35 * k;
        const py = h / 2 + st.y * s * 0.35 * k;
        if (px < 0 || px > w || py < 0 || py > h) { if (move) Object.assign(st, spawn(1)); continue; }
        const r = Math.min(2.2, 0.7 + k * 0.18) * (w / innerWidth);
        ctx.fillStyle = `rgba(${st.t},${Math.min(1, 1.1 - st.z * 0.5)})`;
        ctx.beginPath();
        ctx.arc(px, py, r, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    const loop = () => { draw(true); raf = requestAnimationFrame(loop); };
    resize();
    addEventListener("resize", resize);
    if (reduced) draw(false);
    else loop();
    document.addEventListener("astro:before-swap", () => { cancelAnimationFrame(raf); removeEventListener("resize", resize); }, { once: true });
  }
  start();
</script>
