---
import decks from '../../decks.json';
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
const { title, subtitle } = decks.site;
const link = d => d.migrated ? `${base}${d.slug}/` : `${base}${d.slug}.html`;
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='18' fill='%23E4181B'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;600;800&display=swap" rel="stylesheet">
<style is:inline>
:root{color-scheme:dark;--bg:#000;--ink:#fff;--g1:#a1a1a1;--g2:#666;--line:#262626;--accent:#E4181B;
--sans:"Geist",system-ui,sans-serif;--mono:"Geist Mono",ui-monospace,monospace}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
max-width:820px;padding:clamp(40px,8vw,110px) clamp(20px,6vw,64px);line-height:1.5}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.18em;color:var(--g1);text-transform:uppercase}
h1{font-size:clamp(34px,5vw,60px);letter-spacing:-.04em;font-weight:800;margin:14px 0 6px}
ul{list-style:none;padding:0;margin:34px 0 0}
li{border-top:1px solid var(--line)}
a{display:flex;justify-content:space-between;gap:20px;align-items:baseline;padding:20px 2px;text-decoration:none;color:var(--ink)}
a:hover{background:#0a0a0a}
a small{font-family:var(--mono);font-size:12px;color:var(--g1);letter-spacing:.08em;white-space:nowrap}
.up{margin-top:52px;color:var(--g2);font-size:14px}
.up li{border:0;padding:6px 0;display:flex;justify-content:space-between}
</style>
</head>
<body>
<div class="eyebrow">SOAPBOX — THE YOUTUBE SLIDE SYSTEM</div>
<h1>{title}</h1>
<p style="color:var(--g1);max-width:60ch">{subtitle}</p>
<ul>
{decks.decks.map(d => (
  <li><a href={link(d)}>{d.title}<small>{d.series}</small></a></li>
))}
</ul>
{(decks.planned || []).length > 0 && (
<ul class="up">
{decks.planned.map(p => (
  <li><span>{p.title}</span><small>{p.article}</small></li>
))}
</ul>
)}
</body></html>
