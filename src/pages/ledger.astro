---
/* THE LEDGER — a data table, keyboard-first (concept 3 of 3). */
import Site from '../layouts/Site.astro';
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
const decks = (await import('../../decks.json')).default.decks;
const total = decks.reduce((n, d) => n + (d.scenes || 0), 0);
---
<Site title="Soapbox — Ledger" description="Every deck, as a table." view="ledger">
<div class="wrap">
  <div class="eyebrow">SOAPBOX — THE LEDGER</div>
  <div class="led-sum">
    <span>{String(decks.length).padStart(2, '0')} DECKS</span>
    <span>{total} SCENES</span>
    <span>UPDATED 18 OCT 2026</span>
  </div>
  <table class="ledger" id="ledger">
    <thead><tr><th>#</th><th>Show</th><th>Title</th><th style="text-align:right">Scenes</th></tr></thead>
    <tbody>
      {decks.map((d) => (
        <tr class="row" data-href={`${base}${d.slug}/`} data-search={`${d.title} ${d.show} ${d.series} episode ${d.episode}`.toLowerCase()}>
          <td class="n">{String(d.episode).padStart(2, '0')}</td>
          <td class="show">{d.show.toUpperCase()}</td>
          <td>{d.title}</td>
          <td class="sc">{d.scenes}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="hint">TYPE TO FILTER · ↑↓ MOVE · ⏎ OPEN · 1–{decks.length} JUMP</div>
  <div class="filter" id="filter" aria-live="polite"></div>
</div>
</Site>
<script is:inline slot="script">
(() => {
  const rows = [...document.querySelectorAll('.ledger tr.row')];
  const filterEl = document.getElementById('filter');
  const visible = () => rows.filter((r) => !r.classList.contains('hide'));
  let buf = '';
  const paint = () => {
    rows.forEach((r) => r.classList.toggle('hide', buf !== '' && !r.dataset.search.includes(buf)));
    filterEl.innerHTML = buf ? 'FILTER: <b>' + buf.toUpperCase() + '</b>' : '';
  };
  const move = (dir) => {
    const vis = visible();
    if (!vis.length) return;
    const cur = vis.indexOf(document.querySelector('.ledger tr.row.on'));
    const next = vis[(cur < 0 ? (dir > 0 ? 0 : vis.length - 1) : (cur + dir + vis.length) % vis.length)];
    rows.forEach((r) => r.classList.toggle('on', r === next));
    next.scrollIntoView({ block: 'nearest' });
  };
  const open = () => { const r = document.querySelector('.ledger tr.row.on'); if (r) location.href = r.dataset.href; };
  rows.forEach((r) => r.addEventListener('click', () => { location.href = r.dataset.href; }));
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); return; }
    if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); return; }
    if (e.key === 'Enter') { open(); return; }
    if (e.key === 'Escape') { buf = ''; paint(); return; }
    if (e.key === 'Backspace') { buf = buf.slice(0, -1); paint(); return; }
    if (/^[1-9]$/.test(e.key)) { const r = rows[Number(e.key) - 1]; if (r) location.href = r.dataset.href; return; }
    if (/^[a-z0-9 ]$/i.test(e.key)) { buf += e.key; paint(); }
  });
})();
</script>
