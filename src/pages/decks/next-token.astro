import Deck from '../../layouts/Deck.astro';
---
<Deck title="The Next Token" brand="NEXT TOKEN" series="EPISODE 01 — THE BUILD" chat={true}>
<deck-cue time="COVER" title="The title">Open on the title. Say what the episode is about, then cut straight to the gotcha.</deck-cue>
<deck-cue time="STEP 1 · THE MYSTERY" title="The question">Open on the meme: the models said two, it is three, two camps formed overnight. Land the join: both camps argued about the answer — nobody asked what the machine was looking at.</deck-cue>
<deck-cue time="STEP 2 · ITS EYES" title="It never saw letters">Chunks and numbers, slices that do not align with letters. The JPEG line is the whole point: the information is in there, practically unreadable. Replay the slice on "chunks". Hand-off: so what does it do with them?</deck-cue>
<deck-cue time="STEP 3 · THE LOOP" title="The move and the loop">The whole move is prediction — it commits to a digit with no counter. Kill the smuggled definition of intelligence (flawless, internal, one pass). Intelligence is the loop: intent, artifact, reaction, revision. The correction is the thinking.</deck-cue>
<deck-cue time="STEP 4 · THE PARTNER" title="Not a genius">The builder version: the specification emerges while you build. Not an autonomous genius that takes one perfect brief — a high-bandwidth execution partner. Land the join: "deterministic tools underneath."</deck-cue>
<deck-cue time="STEP 5 · THE ROUTER" title="Compute where exact">The loop alone spins; intelligence is the routing. Four layers; routing itself can fail. Newsboy as the worked proof: compute where exact, infer where ambiguous. Civilisation ran the same playbook.</deck-cue>
<deck-cue time="STEP 6 · THE CATCH" title="The scoreboard">Slow down. Every loop optimises for something, not always what is written on the box. Goodhart: the measure becomes the target — the scoreboard was there all along.</deck-cue>
<deck-cue time="STEP 7 · RUNNING US" title="The same machine, us">Aim it at belief: stated vs revealed preference, badges, insulation, no blame — universal equipment. Then the narrator: the reasons are the press release, the incentives are the process. Climax: build the check outside the thing being checked.</deck-cue>
<deck-cue time="STEP 8 · THE CHECK" title="Let the state decide">The philosophy becomes architecture: plausible is not valid. Inference proposes, authority decides. Prompts persuade; runtimes enforce. "No" has to be a complete answer.</deck-cue>
<deck-cue time="STEP 9 · AT SCALE" title="At scale">Zoom out: Pareto (records, not speeches), Mosca (the political formula), Michels (the iron law where it should have failed). The funnel: the minority sets the menu.</deck-cue>
<deck-cue time="STEP 10 · CLOSE" title="Tokens are cheap">Return to the strawberry. That is the show: not the news, the machinery underneath. Final question to camera — what is your loop optimising for, and can anything outside it tell it it is wrong? Hold. End card: The Tool Call Is Not the Plan.</deck-cue>

<deck-scene id="s0" title="EPISODE 01 — THE BUILD" layout="full" cover>
<h1 class="rise">The Next Token</h1>
<p class="lede rise">Two camps argued about the answer. Nobody asked what the machine was looking at.</p>
</deck-scene>

<deck-scene id="s1" title="THE MYSTERY" layout="split"><div>
<h2 class="rise">The internet's<br>favourite <em class="serif">gotcha.</em></h2>
<p class="lede rise">The models said two. It's three.</p>
<button class="replay rise" data-replay="chat"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE CHAT</button></div>
<deck-chat class="rise" id="rsChat" title="THE MODEL" signal="ONLINE">
<chat-out>How many Rs are in “strawberry”?</chat-out>
<chat-think></chat-think>
<chat-in>2</chat-in>
<chat-out>You can’t count!</chat-out>
</deck-chat></deck-scene>

<deck-scene id="s2" title="ITS EYES" layout="split"><div>
<h2 class="rise">It never saw<br><em class="serif">letters.</em></h2>
<p class="lede rise">Asking it to count the Rs is asking for pixels in a compressed JPEG. The information is in there — practically unreadable.</p>
<button class="replay rise" data-replay="slices"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE SLICE</button></div>
<div class="diagram rise"><div class="dlabel"><span>ONE WORD IN</span><span>TOKENS OUT</span></div>
<div class="word" id="wholeWord">STRAWBERRY</div>
<deck-tiles id="tiles"><deck-tile k="straw" v="1082"></deck-tile><deck-tile k="ber" v="497"></deck-tile><deck-tile k="ry" v="831"></deck-tile></deck-tiles>
<p class="note">The model sees chunks — token fragments that don't line up with the letters inside the word.</p></div></deck-scene>

<deck-scene id="s3" title="THE LOOP" layout="split"><div>
<h2 class="rise">Intelligence<br>isn't one shot.<br><em class="serif">It's the loop.</em></h2>
<p class="lede rise">One move — predict the next chunk. Run it in a loop, and guessing becomes correcting.</p>
<button class="replay rise" data-replay="loop"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE LOOP</button></div>
<div class="diagram rise"><div class="dlabel"><span>THE LOOP</span><span>LIVE</span></div>
<deck-cycle id="loopBox">
<deck-cycle-node note="THE HALF-FORMED IDEA">INTENT</deck-cycle-node>
<deck-cycle-node note="MAKE SOMETHING ROUGH">ARTIFACT</deck-cycle-node>
<deck-cycle-node note="LOOK AT WHAT YOU MADE">REACTION</deck-cycle-node>
<deck-cycle-node note="FIX IT — THAT'S THE THINKING">REVISION</deck-cycle-node>
</deck-cycle>
<p class="note">Correction is the thinking.</p></div></deck-scene>

<deck-scene id="s4" title="THE PARTNER" layout="split"><div>
<h2 class="rise">Not a genius.<br><em class="serif">A partner.</em></h2>
<p class="lede rise">The specification emerges while you build. What the builder needs is bandwidth, not brilliance.</p></div>
<deck-compare class="rise">
<deck-col state="dim"><h3>THE ORACLE MODEL</h3><p>Waits for a perfect brief.</p><p>You specify; it delivers.</p></deck-col>
<deck-col><h3>THE PARTNER</h3><p>The spec emerges while you build.</p><p>Vague intent in, artifact out.</p></deck-col>
</deck-compare></deck-scene>

<deck-scene id="s5" title="THE ROUTER" layout="split"><div>
<h2 class="rise">Compute where<br>computation<br><em class="serif">is exact.</em></h2>
<p class="lede rise">Newsboy: code owns the constraints, the model makes the one semantic choice, code revalidates before it ships.</p></div>
<div class="diagram rise"><div class="dlabel"><span>FOUR LAYERS</span><span>EVERY SYSTEM</span></div>
<deck-stack>
<deck-node label="Recognition" note="What kind of problem is this?" tag="01"></deck-node>
<deck-node label="Routing" note="Which mechanism solves it reliably?" tag="02"></deck-node>
<deck-node label="Execution" note="Run the mechanism" tag="03"></deck-node>
<deck-node label="Interpretation" note="What does it mean, in human terms?" tag="04"></deck-node>
</deck-stack></div></deck-scene>

<deck-scene id="s6" title="THE CATCH" layout="split"><div>
<h2 class="rise">Every loop optimises<br>for <em class="serif">something.</em></h2>
<p class="lede rise">What it optimises for is not always what's written on the box.</p>
<button class="replay rise" data-replay="score"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE SCOREBOARD</button></div>
<div class="diagram rise"><div class="dlabel"><span>GOODHART — THE SCOREBOARD</span><span>THE JOB</span></div>
<deck-counter num-id="scoreNum" value="0.0" suffix="%" bar bar-id="jobBar" bar-left="MEASURE BECOMES THE TARGET" bar-right="THE THING IT WAS TRACKING"></deck-counter>
<p class="note">The scoreboard was there all along. We just had not labelled it.</p></div></deck-scene>

<deck-scene id="s7" title="THE SAME MACHINE, RUNNING US" layout="full">
<div class="finish serif rise">“Nobody has beliefs about gravity.”</div>
<p class="lede rise" style="margin-top:26px">Belief lives where feedback is absent — and that's exactly where a belief can become a badge.</p>
<button class="replay rise" data-replay="badges"><deck-icon name="rotate-ccw"></deck-icon> REPLAY THE BADGES</button>
<deck-chips class="rise" id="badges" style="margin-top:20px"><deck-chip>STATUS</deck-chip><deck-chip>BELONGING</deck-chip><deck-chip>ORIENTATION</deck-chip><deck-chip>MORAL CLEARANCE</deck-chip><deck-chip>INSULATION</deck-chip></deck-chips>
<deck-compare class="rise" style="margin-top:34px">
<deck-col><h3>THE MACHINE</h3>
<p><b>EYES</b> — tokens</p><p><b>MOVE</b> — predicts the next</p><p><b>LOOP</b> — corrects</p></deck-col>
<deck-col><h3>THE SAME MACHINE — US</h3>
<p><b>EYES</b> — badges</p><p><b>MOVE</b> — narrates</p><p><b>LOOP</b> — insulated</p></deck-col>
</deck-compare></deck-scene>

<deck-scene id="s8" title="THE CHECK, ENGINEERED" layout="full">
<h2 class="rise">Let the model propose.<br><em class="serif">Let the state decide.</em></h2>
<deck-grid class="rise" style="margin-top:30px">
<deck-cell state="installed"><b>The database</b><span>Owns whether the customer paid.</span></deck-cell>
<deck-cell state="installed"><b>The calendar</b><span>Owns whether 3:00 PM is taken.</span></deck-cell>
<deck-cell state="installed"><b>The ledger</b><span>Owns the balance. Prose doesn't.</span></deck-cell></deck-grid>
<deck-flow class="rise">
<deck-step>PROPOSE</deck-step><deck-step>PAUSE</deck-step><deck-step>DECIDE</deck-step><deck-step hot>EXECUTE</deck-step>
</deck-flow>
<p class="note rise">Inference proposes, authority decides. Prompts persuade; runtimes enforce. “No” has to be a complete answer.</p>
</deck-scene>

<deck-scene id="s9" title="THE SAME MACHINE, AT SCALE" layout="split"><div>
<h2 class="rise">At scale, democracy<br>is <em class="serif">oligarchy.</em></h2>
<p class="lede rise">Pareto pulled the records, not the speeches. Mosca named the formula. Michels proved it where it should have failed.</p></div>
<div class="diagram rise"><div class="dlabel"><span>THE ELECTION FUNNEL</span><span>WHO CHOOSES?</span></div>
<div class="funnel">
<div class="frow"><div class="fbar" style="width:88%"></div><span>100% — THE PUBLIC</span></div>
<div class="frow"><div class="fbar" style="width:52%"></div><span>2–3% — WOULD EVEN RUN</span></div>
<div class="frow"><div class="fbar" style="width:26%"></div><span>0.1% — CAN SURVIVE THE MACHINE</span></div>
<div class="frow"><div class="fbar" style="width:10%"></div><span>2–3 NAMES — THE BALLOT</span></div>
</div>
<p class="note">By the time a voter walks into the booth, 99.99% of the filtering is done. The minority sets the menu. The majority picks the dish.</p></div></deck-scene>

<deck-scene id="s10" title="CLOSE" layout="full">
<div class="finish rise">Everyone is predicting<br>the next token. <em class="serif">Tokens are cheap.</em></div>
<p class="lede rise" style="margin-top:28px">The question is what the loop is optimising for — and whether anything outside it can tell it it's wrong. <deck-mark inline></deck-mark></p>
<deck-flow class="rise" style="margin-top:34px"><deck-step>NEXT VIDEO</deck-step><deck-step hot>THE TOOL CALL IS NOT THE PLAN</deck-step></deck-flow></deck-scene>
</Deck>

<script is:inline slot="script">
/* Build functions, registered once. The stage resolves them by the scene's
   [data-replay] name and fires on first view and on R. */
const { seq, pulse, count, cycle, register } = window.deckBuild;
let loopState = {};
register({
  chat: () => { const c = document.getElementById('rsChat'); if (c) c.replay(); },
  slices: () => {
    const M = window.deckBuild.Motion;
    if (!M || window.deckBuild.reduced) return;
    const tiles = [...document.querySelectorAll('#tiles .tile')];
    M.animate('#wholeWord', { opacity: [1, .25] }, { duration: .4 });
    tiles.forEach((el, i) => M.animate(el, { x: [0, (i - 1) * 14], opacity: [.2, 1] }, { duration: .55, delay: i * (window.DECK_BEAT / 1000), ease: [.22, 1, .36, 1] }));
  },
  loop: () => { loopState = cycle('#loopBox .loopnode', loopState); },
  score: () => count('scoreNum', 99.9, { bar: 'jobBar', barTo: .18 }),
  badges: () => seq('#badges .badge')
});
</script>
