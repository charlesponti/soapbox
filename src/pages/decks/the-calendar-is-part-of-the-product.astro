.tz .early.arc{stroke-width:2.5}
.tz text.early{fill:var(--accent);stroke:none}
.tz .earlyfill{fill:var(--accent)}
#dayCols .col p.m,#testCols .col p.m{font-size:15px}
</style>

<script is:inline slot="script">
/* Build functions, registered once. The stage resolves them by the scene's
   [data-replay] name and fires on first view and on R. The markup is the
   final state; each build hides its pieces and brings them back on the beat,
   so reduced motion (which skips the build) renders the finished diagram. */
const { seq, register, Motion, reduced } = window.deckBuild;
const beat = () => (window.DECK_BEAT || 900) / 1000;
const ease = [0.22, 1, 0.36, 1];
const rise = 'translateY(12px)';

/* bring SVG groups in, one per beat; each entry is [selector, from?, at?] */
function reveal(steps) {
  if (reduced || !Motion) return;
  steps.forEach(([sel, from, at], i) => {
    const el = document.querySelector(sel);
    if (!el) return;
    el.style.opacity = 0;
    const a = Motion.animate(el, { opacity: [0, 1], transform: [from || rise, 'translate(0px, 0px)'] },
      { delay: (at ?? i) * beat(), duration: 0.6, ease });
    (a.finished || a).then(() => { el.style.opacity = ''; el.style.transform = ''; });
  });
}

register({
  parts: () => seq('#partStack .node'),
  instant: () => {
    if (reduced || !Motion) return;
    const hit = document.getElementById('tzHit');
    hit.style.opacity = 0;
    Motion.animate('#tzCursor', { transform: ['translateX(-125px)', 'translateX(0px)'] }, { duration: 2.2, ease: 'easeInOut' });
    const a = Motion.animate(hit, { opacity: [0, 1] }, { delay: 2.2, duration: 0.6 });
    (a.finished || a).then(() => { hit.style.opacity = ''; });
  },
  four: () => seq('#fourGrid .block'),
  days: () => seq('#dayCols .col'),
  handshake: () => reveal([['#hs1', 'translateX(-24px)'], ['#hs2', 'translateX(24px)'], ['#hs3', 'scale(.96)'], ['#hs4', 'translateX(-24px)'], ['#hs5', 'translateX(24px)']]),
  cookie: () => seq('#cookieRows .mrow:not(.head)'),
  leak: () => reveal([['#lkCards'], ['#lkMark', 'translateY(-14px)'], ['#lkEarly', 'translateY(-14px)']]),
  bound: () => {
    reveal([['#bdCards'], ['#bdWall', 'scaleY(.2)'], ['#bdPick', 'translateY(-14px)', 3]]);
    if (reduced || !Motion) return;
    const far = document.getElementById('bdFar');
    far.setAttribute('opacity', 1);
    Motion.animate(far, { opacity: [1, 0.3] }, { delay: 2 * beat(), duration: 0.8 }).then?.(() => far.setAttribute('opacity', 0.3));
  },
  resolver: () => seq('#resolveStack .node'),
  dst: () => {
    if (reduced || !Motion) return;
    document.querySelectorAll('#s10 .bar').forEach((bar, i) => {
      bar.style.transformBox = 'fill-box';
      bar.style.transformOrigin = '0 50%';
      Motion.animate(bar, { transform: ['scaleX(0)', 'scaleX(1)'] }, { delay: i * 0.5 * beat(), duration: 0.9, ease });
    });
    reveal([['#dstMark', rise, 3.2]]);
  },
  test: () => seq('#testCols .col')
});
</script>
