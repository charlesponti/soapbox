---
/* THE WALL — the covers are the index (concept 2 of 3). */
import Site from '../../layouts/Site.astro';
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
const decks = (await import('../../../decks.json')).default.decks;
const shows = [...new Set(decks.map((d) => d.show))].map((show) => ({ show, decks: decks.filter((d) => d.show === show) }));
---
<Site title="Soapbox — Decks" description="Full-screen decks for a series of talks." view="wall">
<div class="wrap">
  <div class="eyebrow">SOAPBOX — FULL-SCREEN DECKS</div>
  <h1 class="site-title">The work, <em>on the wall.</em></h1>
  <p class="site-lede">Every cover is a deck. Nine to eleven scenes each, black and white, and no slide you could have read instead.</p>
  {shows.map(({ show, decks }) => (
    <section>
      <div class="show-head">{show.toUpperCase()}</div>
      <div class="wall-grid">
        {decks.map((d) => (
          <a class="wall-tile" href={`${base}decks/${d.slug}/`} data-rise>
            <img src={`${base}og/${d.slug}.png`} alt="" loading="lazy" width="1200" height="630" />
            <span class="wall-cap"><b>{String(d.episode).padStart(2, '0')} · {d.title}</b><span>{d.scenes} SCENES</span></span>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>
</Site>
<script is:inline slot="script">
(() => {
  const M = window.Motion, reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tiles = [...document.querySelectorAll('[data-rise]')];
  if (!M || reduced) return;                       // no-JS / reduced: rendered visible
  tiles.forEach((t) => { t.style.opacity = 0; });
  M.inView(document.querySelector('.wrap'), () => {
    M.animate(tiles, { opacity: [0, 1], y: [22, 0] }, { duration: 0.6, delay: M.stagger(0.06), ease: [0.22, 1, 0.36, 1] });
  }, { amount: 0.1 });
})();
</script>
