# macOS
.DS_Store

# Sync PoC media is workspace-only (poc/README.md): regenerate, never commit.
# The durable artifact is poc/manifest.json; the audio, frames, stills and
# rendered MP4 are not.
poc/audio/
poc/frames/
poc/*.mp3
poc/*.mp4
poc/still-*.jpg

# Astro build (Phase 0/1 migration — components/ is the source of truth;
# public/components is a generated mirror, see astro.config.mjs)
node_modules/
dist/
.astro/
public/components/

# Playwright
playwright-report/
test-results/

# Essays (lexicon) — vault content is local-only and must never be committed
staged/
site/
src/content/essays/
src/lib/slug-map.json
public/pagefind/
.playwright-mcp
